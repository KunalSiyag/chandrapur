# Copy to .env. Everything is optional: without keys the villagers still talk
# (scripted and offline lines) using the browser's own voices.

# --- Free conversation with villagers (any OpenAI-compatible chat API) ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1      # or GMI Cloud, OpenRouter, a local Ollama /v1, ...
# LLM_MODEL=gpt-4o-mini
# GMI_API_KEY / GMI_MODEL are still honoured as a fallback (base URL: GMI Cloud).

# --- Neural villager voices (OpenAI-compatible /audio/speech) ---
# TTS_API_KEY=sk-...
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_MODEL=gpt-4o-mini-tts

# --- Rendering more ACE-Step takes (tools/acestep.py) ---
# HF_TOKEN=hf_...                              # more ZeroGPU quota on Hugging Face
