# Copy to .env. Everything is optional: without keys the villagers still talk
# (scripted lines play pre-rendered voices; conversation answers offline).

# --- One key for everything: GMI Cloud ---
# GMI_API_KEY=...
# GMI_MODEL=zai-org/GLM-5.3-Flash            # villagers' brain (fast, ~1.6 s median)
#   -> chat via api.gmi-serving.com/v1, voices via Inworld TTS-2 on GMI's request queue

# --- Or any OpenAI-compatible chat API for the brain ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1      # OpenRouter, a local Ollama /v1, ...
# LLM_MODEL=gpt-4o-mini

# --- Voices ---
# TTS_PROVIDER=gmi                            # gmi (default with GMI_API_KEY) | openai | off
# TTS_MODEL=inworld-tts-2                     # scripted lines, directed per villager
# TTS_LIVE_MODEL=inworld-tts-2-flash          # live conversation replies (faster)
# TTS_API_KEY=sk-...  TTS_BASE_URL=...        # for TTS_PROVIDER=openai (gpt-4o-mini-tts)

# --- Rendering more ACE-Step takes (tools/acestep.py) ---
# HF_TOKEN=hf_...                              # more ZeroGPU quota on Hugging Face
