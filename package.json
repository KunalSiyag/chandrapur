{
  "name": "chandrapur",
  "private": true,
  "version": "2.0.0",
  "description": "Chandrapur: a harvest-fair day in a North Indian railway town, built procedurally in Three.js, with villagers you can talk to by voice and a soundtrack generated with ACE-Step.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node agent/screenshot.js",
    "test:player-pose": "node agent/check-player-pose.mjs",
    "test:town": "node agent/check-town.mjs && node agent/check-walking.mjs && node agent/check-balloon.mjs && node agent/check-life.mjs && node agent/check-ui.mjs",
    "screenshots:town": "node agent/town-shots.mjs",
    "test:production": "node agent/check-production.mjs",
    "agent": "node agent/agent.js",
    "start": "node server/serve.mjs",
    "test:voice": "node agent/check-voice.mjs",
    "test:audio": "node agent/check-audio.mjs",
    "music": "uv run tools/acestep.py",
    "voices": "node tools/render-voices.mjs"
  },
  "keywords": [
    "three",
    "webgl",
    "game",
    "india",
    "ace-step",
    "music-generation",
    "voice",
    "llm",
    "npc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "openai": "^4.104.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^8.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KunalSiyag/chandrapur.git"
  }
}
